# Copy to .env for local development.  Settings read real environment
# variables first, so an exported value always wins over this file.

# --- Core ---------------------------------------------------------------
# Leave DJANGO_SECRET_KEY empty only while DJANGO_DEBUG=1; with debug off the
# app refuses to start without it.  Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# sqlite (default) or postgres
DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_NAME=greetingapi
# DJANGO_DB_USER=greetingapi
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60

# --- OAuth2 -------------------------------------------------------------
OAUTH2_ACCESS_TOKEN_TTL_HOURS=1
# Name of the Application row tokens are issued against.  Unset means the
# lowest-numbered Application.
# OAUTH2_APPLICATION_NAME=

# --- HTTPS (only read when DJANGO_DEBUG is off) --------------------------
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
